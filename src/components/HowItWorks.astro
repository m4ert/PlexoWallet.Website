---
// HowItWorks.astro

const steps = [
  {
    icon: "add_card",
    step: "01",
    title: "Add Card Names",
    description:
      "Simply enter the names of your cards. No numbers, no CVV, no expiry. Your identity stays yours.",
  },
  {
    icon: "loyalty",
    step: "02",
    title: "Link Memberships",
    description:
      "Connect store loyalty programs and club memberships to unlock hidden stackable discounts.",
  },
  {
    icon: "savings",
    step: "03",
    title: "Save Everywhere",
    description:
      "Plexo Wallet automatically surfaces the best card for every store, online or in-person.",
  },
];
---

<section
  id="how-it-works"
  class="py-24 px-6 md:px-8
         bg-slate-50 dark:bg-[#0c0e10]"
>
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <span
        class="text-xs font-bold tracking-widest uppercase text-primary dark:text-blue-400 mb-3 block"
      >
        Simple Process
      </span>
      <h2
        class="font-headline font-bold text-4xl md:text-5xl tracking-tight
               text-slate-900 dark:text-white mb-4"
      >
        Three steps to mastery.
      </h2>
      <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto text-lg">
        Our workflow is designed for maximum efficiency and zero friction.
      </p>
    </div>

    <!-- Steps grid -->
    <div class="grid md:grid-cols-3 gap-6 relative">
      <!-- Connector line (desktop only) -->
      <div
        class="hidden md:block absolute top-10 left-[calc(16.666%+2rem)] right-[calc(16.666%+2rem)] h-px
               bg-gradient-to-r from-transparent via-slate-200 dark:via-white/10 to-transparent
               z-0"
      ></div>

      {
        steps.map((s, i) => (
          <div
            class="relative z-10 group rounded-3xl p-8 border transition-all duration-300
                   bg-white border-slate-100 hover:border-slate-200 hover:shadow-xl hover:-translate-y-1
                   dark:bg-[#1a1d1f] dark:border-white/6 dark:hover:border-white/12 dark:hover:shadow-2xl"
          >
            <!-- Step number badge -->
            <div
              class="absolute -top-3 -right-3 w-7 h-7 rounded-full flex items-center justify-center
                     text-[10px] font-black
                     bg-primary text-white
                     shadow-lg shadow-blue-500/30"
            >
              {s.step}
            </div>

            <!-- Icon -->
            <div
              class="w-14 h-14 rounded-2xl flex items-center justify-center mb-6
                     bg-primary/8 text-primary
                     dark:bg-primary/15 dark:text-blue-400
                     group-hover:scale-110 transition-transform duration-300"
            >
              <span class="material-symbols-outlined text-3xl">{s.icon}</span>
            </div>

            <h3
              class="font-headline font-bold text-xl mb-3
                     text-slate-900 dark:text-white"
            >
              {s.title}
            </h3>
            <p class="text-slate-500 dark:text-slate-400 leading-relaxed text-sm">
              {s.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
