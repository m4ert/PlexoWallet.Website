---
// USFocus.astro

const stats = [
  { value: "6+", label: "Major Banks" },
  { value: "20+", label: "Store Brands" },
  { value: "50K+", label: "Active Users" },
  { value: "$2M+", label: "Total Saved" },
];
---

<section id="global" class="py-24 px-6 md:px-8">
  <div class="max-w-7xl mx-auto">
    <div
      class="bg-blue-gradient rounded-[3rem] p-10 md:p-20 text-white
             flex flex-col md:flex-row items-center gap-12
             overflow-hidden relative"
    >
      <!-- Decorative background icon -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <span
          class="material-symbols-outlined select-none
                 text-[26rem] md:text-[32rem] text-white/5
                 absolute -bottom-24 -right-24 leading-none"
        >
          public
        </span>
      </div>

      <!-- Left: copy + stats -->
      <div class="md:w-1/2 relative z-10">
        <span class="text-xs font-bold tracking-widest uppercase text-blue-200 mb-4 block">
          Built for the US Market
        </span>
        <h2
          class="font-headline font-extrabold text-4xl md:text-5xl mb-6 tracking-tight"
        >
          Optimized for American consumers.
        </h2>
        <p class="text-blue-100 text-lg mb-10 leading-relaxed">
          We support the 6 major US banks and 20+ national retailers with full
          security protocols — so you can shop with confidence coast to coast.
        </p>

        <!-- Stats grid -->
        <div class="grid grid-cols-2 gap-4">
          {
            stats.map((s) => (
              <div
                class="backdrop-blur-md p-5 rounded-2xl border border-white/20
                       bg-white/10 hover:bg-white/15 transition-colors"
              >
                <div class="text-3xl font-black mb-1 font-headline">{s.value}</div>
                <div class="text-xs opacity-80 font-semibold uppercase tracking-wider">
                  {s.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right: map card -->
      <div class="md:w-1/2 relative z-10 flex justify-center">
        <div
          class="w-full max-w-xs rotate-3 shadow-2xl
                 bg-white/20 backdrop-blur-xl p-2 rounded-3xl border border-white/30"
        >
          <!-- Map placeholder (stylized) -->
          <div
            class="rounded-2xl overflow-hidden relative"
            style="height: 260px; background: linear-gradient(135deg, #1e3a5f 0%, #0f2345 100%);"
          >
            <!-- US map dots (decorative) -->
            <div class="absolute inset-0 p-4">
              <div class="relative w-full h-full">
                {
                  [
                    { top: "25%", left: "18%", size: "lg" },
                    { top: "38%", left: "35%", size: "sm" },
                    { top: "20%", left: "55%", size: "lg" },
                    { top: "45%", left: "62%", size: "sm" },
                    { top: "30%", left: "75%", size: "lg" },
                    { top: "55%", left: "45%", size: "sm" },
                    { top: "60%", left: "78%", size: "lg" },
                    { top: "15%", left: "42%", size: "sm" },
                  ].map((dot) => (
                    <div
                      class="absolute"
                      style={`top: ${dot.top}; left: ${dot.left};`}
                    >
                      <div
                        class={`rounded-full bg-blue-400 animate-ping absolute ${dot.size === "lg" ? "w-3 h-3 -top-1.5 -left-1.5" : "w-2 h-2 -top-1 -left-1"} opacity-40`}
                      />
                      <div
                        class={`rounded-full bg-white shadow-lg shadow-blue-400/40 ${dot.size === "lg" ? "w-3 h-3" : "w-2 h-2"}`}
                      />
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="absolute bottom-4 left-4 right-4 text-center">
              <p class="text-white/90 font-headline font-bold text-sm">
                Nationwide Coverage
              </p>
              <p class="text-white/50 text-xs">All 50 states supported</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
