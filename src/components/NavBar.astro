---
import ThemeToggle from "./ThemeToggle.astro";

const navLinks = [
  { label: "How it Works", href: "#how-it-works" },
  { label: "Security", href: "#security" },
  { label: "Features", href: "#features" },
  { label: "Global", href: "#global" },
];
---

<nav
  class="fixed top-0 w-full z-50 glass-nav"
  style="box-shadow: 0 4px 30px rgba(0,0,0,0.04);"
>
  <div class="flex justify-between items-center px-6 md:px-8 py-4 max-w-7xl mx-auto">
    <!-- Logo -->
    <a
      href="/"
      class="text-2xl font-black tracking-tighter font-headline
             text-slate-900 dark:text-white
             hover:opacity-80 transition-opacity"
    >
      Plexo Wallet
    </a>

    <!-- Desktop nav links -->
    <div class="hidden md:flex gap-8 items-center">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-headline tracking-tight text-sm font-semibold transition-colors duration-200
                   text-slate-500 hover:text-slate-900
                   dark:text-slate-400 dark:hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Right side: theme toggle + CTA -->
    <div class="flex items-center gap-3">
      <ThemeToggle />

      <button
        class="bg-blue-gradient text-white px-5 py-2.5 rounded-full font-semibold text-sm
               hover:opacity-90 active:scale-95 transition-all shadow-md shadow-blue-500/20"
      >
        Download Now
      </button>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        aria-label="Open menu"
        class="md:hidden w-10 h-10 flex flex-col gap-1.5 items-center justify-center
               rounded-full hover:bg-slate-100 dark:hover:bg-white/10 transition-colors"
      >
        <span class="w-5 h-0.5 bg-current rounded-full transition-all"></span>
        <span class="w-5 h-0.5 bg-current rounded-full transition-all"></span>
        <span class="w-5 h-0.5 bg-current rounded-full transition-all"></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden flex-col gap-1 px-6 pb-4 border-t
           border-slate-100 dark:border-white/5"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="block py-2.5 font-headline font-semibold text-sm tracking-tight
                 text-slate-600 hover:text-slate-900
                 dark:text-slate-400 dark:hover:text-white
                 transition-colors"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
  });
</script>
