---
// Footer.astro

const productLinks = ["How it Works", "Features", "Global Support", "Pricing"];
const companyLinks = ["Security", "Privacy Policy", "Terms of Service", "Blog"];
const year = new Date().getFullYear();
---

<footer
  class="border-t font-body text-sm leading-relaxed
         bg-slate-50 border-slate-200
         dark:bg-[#0a0c0e] dark:border-white/6"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 mb-14">

      <!-- Brand column -->
      <div class="sm:col-span-2 md:col-span-1">
        <div
          class="text-xl font-black font-headline tracking-tighter mb-4
                 text-slate-900 dark:text-white"
        >
          Plexo Wallet
        </div>
        <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed max-w-xs">
          The premier wallet for American smart savers. Impenetrable
          security, airy clarity.
        </p>

        <!-- Badges -->
        <div class="mt-5 flex flex-wrap gap-2">
          {
            ["SOC 2", "GDPR", "AES-256"].map((b) => (
              <span
                class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md
                       bg-slate-200 text-slate-500
                       dark:bg-white/8 dark:text-slate-400"
              >
                {b}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Product links -->
      <div>
        <h4
          class="font-bold text-sm mb-5 uppercase tracking-widest
                 text-slate-900 dark:text-white"
        >
          Product
        </h4>
        <ul class="space-y-3">
          {
            productLinks.map((link) => (
              <li>
                <a
                  href="#"
                  class="text-slate-500 hover:text-primary transition-colors
                         dark:text-slate-400 dark:hover:text-blue-400"
                >
                  {link}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company links -->
      <div>
        <h4
          class="font-bold text-sm mb-5 uppercase tracking-widest
                 text-slate-900 dark:text-white"
        >
          Company
        </h4>
        <ul class="space-y-3">
          {
            companyLinks.map((link) => (
              <li>
                <a
                  href="#"
                  class="text-slate-500 hover:text-primary transition-colors
                         dark:text-slate-400 dark:hover:text-blue-400"
                >
                  {link}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h4
          class="font-bold text-sm mb-5 uppercase tracking-widest
                 text-slate-900 dark:text-white"
        >
          Connect
        </h4>
        <div class="flex gap-3 mb-6">
          {
            [
              { icon: "share", label: "Share" },
              { icon: "mail", label: "Email" },
              { icon: "rss_feed", label: "RSS" },
            ].map((s) => (
              <button
                aria-label={s.label}
                class="w-10 h-10 rounded-full flex items-center justify-center
                       transition-all hover:scale-110
                       bg-slate-200 text-slate-600 hover:bg-primary hover:text-white
                       dark:bg-white/8 dark:text-slate-400 dark:hover:bg-blue-500/30 dark:hover:text-blue-300"
              >
                <span class="material-symbols-outlined text-[1.1rem]">{s.icon}</span>
              </button>
            ))
          }
        </div>

        <p class="text-slate-400 dark:text-slate-500 text-xs leading-relaxed">
          Questions? Reach us at<br />
          <a
            href="mailto:hello@digitalvault.app"
            class="text-primary dark:text-blue-400 hover:underline"
          >
            hello@digitalvault.app
          </a>
        </p>
      </div>

    </div>

    <!-- Bottom bar -->
    <div
      class="pt-8 border-t flex flex-col sm:flex-row justify-between items-center gap-3
             border-slate-200 dark:border-white/6"
    >
      <p class="text-slate-400 dark:text-slate-500 text-xs">
        © {year} Plexo Wallet. All rights reserved.
      </p>
      <div class="flex gap-5">
        {
          ["Privacy", "Terms", "Cookies"].map((item) => (
            <a
              href="#"
              class="text-xs text-slate-400 hover:text-primary transition-colors
                     dark:text-slate-500 dark:hover:text-blue-400"
            >
              {item}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
