---
// Download.astro
---

<section class="py-24 px-6 md:px-8 mb-12">
  <div class="max-w-7xl mx-auto">
    <div
      class="bg-blue-gradient rounded-[3rem] p-12 md:p-24 text-center text-white
             shadow-2xl shadow-blue-500/25 relative overflow-hidden"
    >
      <!-- Decorative blobs -->
      <div
        class="absolute top-0 left-0 w-64 h-64 bg-white/10 rounded-full
               -translate-x-1/2 -translate-y-1/2 blur-3xl pointer-events-none"
      ></div>
      <div
        class="absolute bottom-0 right-0 w-96 h-96 bg-white/5 rounded-full
               translate-x-1/4 translate-y-1/4 blur-3xl pointer-events-none"
      ></div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
               w-[600px] h-[600px] rounded-full bg-white/3 blur-3xl pointer-events-none"
      ></div>

      <!-- Content -->
      <div class="relative z-10">
        <span
          class="text-xs font-bold tracking-widest uppercase text-blue-200 mb-4 block"
        >
          Start for Free
        </span>

        <h2
          class="font-headline font-black text-5xl md:text-7xl mb-6 tracking-tight"
        >
          Ready to Save?
        </h2>

        <p class="text-white/80 text-xl md:text-2xl mb-12 max-w-2xl mx-auto leading-relaxed">
          Join 50,000+ users who are optimizing their wallet every day with
          Plexo Wallet. Free to download, forever.
        </p>

        <!-- App store buttons -->
        <div class="flex flex-col sm:flex-row justify-center gap-5 mb-12">
          <!-- App Store -->
          <a
            href="#"
            class="group flex items-center gap-4 px-6 py-4 rounded-2xl
                   bg-black/60 backdrop-blur-sm border border-white/20
                   hover:bg-black/80 hover:scale-105 hover:shadow-2xl
                   active:scale-95 transition-all duration-200"
          >
            <span class="material-symbols-outlined text-3xl text-white">phone_iphone</span>
            <div class="text-left">
              <p class="text-[10px] text-white/60 uppercase tracking-wider font-semibold">
                Download on the
              </p>
              <p class="text-lg font-bold font-headline leading-tight">App Store</p>
            </div>
          </a>

          <!-- Google Play -->
          <a
            href="#"
            class="group flex items-center gap-4 px-6 py-4 rounded-2xl
                   bg-black/60 backdrop-blur-sm border border-white/20
                   hover:bg-black/80 hover:scale-105 hover:shadow-2xl
                   active:scale-95 transition-all duration-200"
          >
            <span class="material-symbols-outlined text-3xl text-white">android</span>
            <div class="text-left">
              <p class="text-[10px] text-white/60 uppercase tracking-wider font-semibold">
                Get it on
              </p>
              <p class="text-lg font-bold font-headline leading-tight">Google Play</p>
            </div>
          </a>
        </div>

        <!-- Social proof strip -->
        <div
          class="inline-flex items-center gap-3 px-5 py-3 rounded-full
                 bg-white/10 border border-white/15 backdrop-blur-sm"
        >
          <div class="flex -space-x-2">
            {
              ["#60a5fa", "#34d399", "#f59e0b", "#f472b6"].map((color) => (
                <div
                  class="w-7 h-7 rounded-full border-2 border-white/30 flex items-center justify-center text-[10px] font-bold text-white"
                  style={`background: ${color};`}
                >
                  ★
                </div>
              ))
            }
          </div>
          <span class="text-sm font-semibold text-white/90">
            Loved by 50,000+ smart savers
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
